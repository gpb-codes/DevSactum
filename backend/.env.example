# ─── Database ──────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devsactum
POSTGRES_USER=devsactum
POSTGRES_PASSWORD=changeme_in_prod

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_prod

# ─── MinIO (S3-compatible) ─────────────────────────────────────────
MINIO_ROOT_USER=devsactum
MINIO_ROOT_PASSWORD=changeme_in_prod
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=devsactum
MINIO_SECRET_KEY=changeme_in_prod
MINIO_BUCKET=devsactum-files
MINIO_PUBLIC_URL=http://localhost:9000

# ─── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=devsactum
RABBITMQ_DEFAULT_PASS=changeme_in_prod

# ─── NestJS API ────────────────────────────────────────────────────
NESTJS_PORT=8001
NESTJS_JWT_SECRET=your-jwt-secret-here
NESTJS_JWT_EXPIRES_IN=7d

# ─── Go API ────────────────────────────────────────────────────────
GO_API_PORT=8000

# ─── Python Worker ─────────────────────────────────────────────────
PYTHON_WORKER_DEBUG=true

# ─── AI / Voltagent ────────────────────────────────────────────────
VOLTAGENT_API_KEY=
VOLTAGENT_API_URL=https://api.voltagent.dev/v1

# ─── PayPal ────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ─── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_GO=http://localhost:8000/api/v1
NEXT_PUBLIC_API_NESTJS=http://localhost:8001/api/v1
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
